  "helpWifiTitle": "Local Wi-Fi P2P Device Sync",
  "@helpWifiTitle": {
    "description": "Help topic title: local Wi-Fi sync."
  },
  "helpWifiIntro": "Transfer and synchronize your tasks, time records, and mastery flashcards directly between two devices on the same local Wi-Fi network — with zero cloud servers and zero internet traffic.",
  "@helpWifiIntro": {
    "description": "Help: Wi-Fi sync intro paragraph."
  },
  "helpWifiHowTitle": "How Local Wi-Fi Sync Works",
  "@helpWifiHowTitle": {
    "description": "Help: Wi-Fi sync section title."
  },
  "helpWifiHow1": "Both devices must be connected to the same local Wi-Fi network (or one device connected to the other’s hotspot).",
  "@helpWifiHow1": {
    "description": "Help: how sync works bullet."
  },
  "helpWifiHow2": "One device acts as the Sender/Host (generating a temporary pairing code / QR code), and the other acts as the Receiver.",
  "@helpWifiHow2": {
    "description": "Help: how sync works bullet."
  },
  "helpWifiHow3": "Data is transferred directly socket-to-socket over your local LAN, completely bypassing external servers or the internet.",
  "@helpWifiHow3": {
    "description": "Help: how sync works bullet."
  },
  "helpWifiEncryptionTitle": "End-to-End Encryption",
  "@helpWifiEncryptionTitle": {
    "description": "Help: Wi-Fi sync section title."
  },
  "helpWifiEncryption1": "Local sync connections negotiate an encrypted channel using one-time pairing credentials.",
  "@helpWifiEncryption1": {
    "description": "Help: encryption bullet."
  },
  "helpWifiEncryption2": "Other devices on the same Wi-Fi network cannot inspect or tamper with the transferred payload.",
  "@helpWifiEncryption2": {
    "description": "Help: encryption bullet."
  },
  "helpWifiModesTitle": "Sync Modes & Conflicts",
  "@helpWifiModesTitle": {
    "description": "Help: Wi-Fi sync section title."
  },
  "helpWifiModes1": "Two-Way Smart Merge: Combines tasks and segments from both devices without losing existing records.",
  "@helpWifiModes1": {
    "description": "Help: sync modes bullet."
  },
  "helpWifiModes2": "Replace All: Replaces the target device’s data completely with an exact clone of the source device (after confirmation).",
  "@helpWifiModes2": {
    "description": "Help: sync modes bullet."
  },
  "helpWifiTip": "Tip: If your Wi-Fi router blocks client-to-client traffic (client isolation), simply turn on a mobile hotspot on one phone and connect the other phone to it.",
  "@helpWifiTip": {
    "description": "Help: Wi-Fi sync footer tip."
  },
